{
  "mcpServers": {
    "forgejo-mcp": {
      "type": "http",
      "url": "https://forgejo.home.janbaer.de/mcp",
      "headers": {
        "Authorization": "token ${FORGEJO_API_TOKEN}"
      }
    },
    "vikunja-builtin": {
      "type": "http",
      "url": "https://todo.home.janbaer.de/api/v2/mcp",
      "headers": {
        "Authorization": "Bearer ${VIKUNJA_MCP_TOKEN}"
      }
    },
    "imap-mcp": {
      "command": "node",
      "args": ["/home/jan/Projects/imap-mini-mcp/dist/index.js"],
      "env": {
        "IMAP_HOST": "imap.mailbox.org",
        "IMAP_USER": "${MAILBOX_ORG_USERNAME}",
        "IMAP_PASS": "${MAILBOX_ORG_IMAP_PASSWORD}"
      }
    },
    "caldav-mcp": {
      "command": "node",
      "args": ["/home/jan/Projects/caldav-mcp/dist/index.js"],
      "env": {
        "CALDAV_BASE_URL": "https://dav.mailbox.org/caldav/",
        "CALDAV_USERNAME": "${MAILBOX_ORG_USERNAME}",
        "CALDAV_PASSWORD": "${MAILBOX_ORG_CALDAV_PASSWORD}"
      }
    },
    "carddav-mcp": {
      "command": "node",
      "args": ["/home/jan/Projects/carddav-mcp/dist/index.js"],
      "env": {
        "CARDDAV_BASE_URL": "https://dav.mailbox.org/carddav/",
        "CARDDAV_USERNAME": "${MAILBOX_ORG_USERNAME}",
        "CARDDAV_PASSWORD": "${MAILBOX_ORG_CALDAV_PASSWORD}"
      }
    },
    "unifi": {
      "command": "uvx",
      "args": ["--from", "unifi-network-mcp==0.33.0", "unifi-network-mcp"],
      "env": {
        "UNIFI_HOST": "192.168.1.1",
        "UNIFI_USERNAME": "claude",
        "UNIFI_PASSWORD": "${UNIFI_PASSWORD}",
        "UNIFI_VERIFY_SSL": "false",
        "UNIFI_TOOL_REGISTRATION_MODE": "eager"
      }
    }
  }
}
